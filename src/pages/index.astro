---
import BaseLayout from "../layouts/BaseLayout.astro";
import posts from "../data/posts.json";
const recentPosts = posts.posts.slice(0, 8);
---
<BaseLayout title="沅泽的学习博客" description="记录学习、实践与复盘的个人博客。">
  <div class="container">
    <section class="hero">
      <div>
        <div class="eyebrow">Learning in public</div>
        <h1>把每天的学习，<br />变成可以回看的路。</h1>
        <p>这里记录编程、计算机基础、实践项目和问题排查。文章不只展示结果，也保留理解、试错和复盘的过程。</p>
      </div>
      <div class="hero-card">
        <strong>持续记录，逐步积累</strong>
        <span class="muted">代码与研究笔记各归其位；事实、实践和待验证的问题分别写清楚。</span>
      </div>
    </section>

    <section class="learning-section" aria-labelledby="learning-sections">
      <div class="section-heading"><h2 id="learning-sections">学习专区</h2></div>
      <div class="learning-grid">
        <a class="post-card" href={`${import.meta.env.BASE_URL}python/`}>
          <div class="eyebrow">Code notebook</div>
          <h3>Python 学习</h3>
          <p>按功能拆开日常练习，回看代码与踩坑记录。</p>
        </a>
        <a class="post-card" href={`${import.meta.env.BASE_URL}llm/`}>
          <div class="eyebrow">Research notes</div>
          <h3>大模型学习</h3>
          <p>记录大模型基础、模型量化、推理加速的阅读与实践。</p>
        </a>
      </div>
    </section>

    <section aria-labelledby="recent-posts">
      <div class="section-heading">
        <h2 id="recent-posts">最近文章</h2>
        <span class="muted">{posts.posts.length} 篇记录</span>
      </div>
      <div class="post-list">
        {recentPosts.map((post) => (
          <a class="post-card" href={`${import.meta.env.BASE_URL}${post.url}`}>
            <div class="post-meta"><time datetime={post.date}>{post.date}</time><span>·</span><span>{post.category}</span></div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
            <div class="tags">{post.tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
