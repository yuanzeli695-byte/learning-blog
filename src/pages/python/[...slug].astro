---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPythonEntries } from '../../lib/python-library';

export function getStaticPaths() {
  return getPythonEntries().map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---
<BaseLayout title={`${entry.title} | Python 学习 | 沅泽的学习博客`} description={entry.summary || `${entry.topic}：Python 分段学习笔记。`}>
  <article class="article-wrap python-detail">
    <a class="eyebrow" href={`${import.meta.env.BASE_URL}python/`}>← 返回 Python 学习</a>
    <h1>{entry.title}</h1>
    <div class="post-meta">
      <span>{entry.topic}</span><span>·</span><span>由 {entry.source} 整理</span>
      {entry.date && <time datetime={entry.date}>原文件更新 {entry.date}</time>}
    </div>
    <p class="python-lead">{entry.summary}</p>
    <p class="python-provenance">按用途拆开了原练习，删掉重复或失效的注释；有些片段为方便独立阅读作了改写，并非原文件的逐字备份。</p>

    {entry.sections.length > 2 && <nav class="python-section-nav" aria-label="本篇目录">
      {entry.sections.map((section, index) => <a href={`#part-${index + 1}`}>{index + 1}. {section.title}</a>)}
    </nav>}

    {entry.sections.map((section, index) => (
      <section class="python-example" id={`part-${index + 1}`} aria-labelledby={`part-heading-${index + 1}`}>
        <div class="python-part-label">练习 {String(index + 1).padStart(2, '0')}</div>
        <h2 id={`part-heading-${index + 1}`}>{section.title}</h2>
        <p>{section.intro}</p>
        <pre class="python-code"><code class="language-python">{section.code}</code></pre>
      </section>
    ))}

    {entry.notes.length > 0 && <aside class="python-notes"><h2>复盘与提醒</h2><ul>{entry.notes.map((note) => <li>{note}</li>)}</ul></aside>}
    <p class="muted">这些代码在网页里只作静态展示，不会自动执行。含输入或文件操作的示例请先理解后再运行。</p>
  </article>
</BaseLayout>
